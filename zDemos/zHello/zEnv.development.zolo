# zHello — zEnv.development (dev-only overrides)
#
# TODO(public-release): remove this file (or unset ZBIFROST_CLIENT_BASE) so the
# app falls back to the CDN @1 channel (https://fastly.jsdelivr.net/npm/@zolomedia/bifrost-client@1).
# Until then, golden-app demos serve the LOCAL zbifrost-client working tree so
# byte-truth == disk and there's no CDN/npm propagation lag while iterating.
# Absolute path on purpose (the client lives OUTSIDE the app root, so no @.zPath).
ZBIFROST_CLIENT_BASE: /zbifrost
zServer:
    mounts:
        zbifrost: /Users/galnachshon/Projects/zbifrost-client
