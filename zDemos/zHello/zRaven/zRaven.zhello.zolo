# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# zRavenVersion: v1.0.0
# Generated by:  z raven --gen, hand-extended per 00_workflow.md phase_Bifrost.e_zRaven
# Source:        zUI.zhello.zolo
# zPick is dual-mode (see 13_testing) — same step drives the CLI menu AND
# clicks button[data-key='<Option>'] in zBifrost, no hand-swap needed.

Tests:

    # ── Bifrost: open page ──────────────────────────────────────────────
    Open_App:
        zOpen: zSpark
        zWait:
            selector: h1
            state: visible
            timeout: 8000

    # ── Greeting_Actions (zModal glance-and-return) ──────────────────────
    Pick_Say_Hello:
        zPick: Say_Hello
        zWait:
            selector: .zModal-close
            state: visible

    Assert_Hello:
        zAssert:
            dom:
                selector: body
                contains: Hello, Zolo!

    Close_Hello_Modal:
        zClick:
            selector: .zModal-close

    Pick_Say_Goodbye:
        zPick: Say_Goodbye
        zWait:
            selector: .zModal-close
            state: visible

    Assert_Goodbye:
        zAssert:
            dom:
                selector: body
                contains: Goodbye, Zolo!

    Close_Goodbye_Modal:
        zClick:
            selector: .zModal-close

    # ── Shippable bar: 3 viewports ────────────────────────────────────────
    Shot_mobile:
        zViewport: mobile
        zOpen: zSpark
        zWait:
            selector: h1
            state: visible
        zShot: {}

    Shot_tablet:
        zViewport: tablet
        zOpen: zSpark
        zWait:
            selector: h1
            state: visible
        zShot: {}

    Shot_desktop:
        zViewport: desktop
        zOpen: zSpark
        zWait:
            selector: h1
            state: visible
        zShot: {}

    Done:
        zMarker: done
