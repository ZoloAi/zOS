# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# zRavenVersion: v1.0.0
# Generated by:  z raven --gen (structural skeleton only — auth flow hand-tuned)
# Source:        zUI.zTeamVault.zolo
# Re-run z raven --gen to refresh the structural skeleton; this file's
# hand-authored zClick/zFill/zAssert browser flow is NOT auto-generated —
# no golden app yet combines zLogin + zGate + Bifrost browser assertions,
# so this IS the reference pattern (15_rbac.md).

Tests:

    # ── Bifrost: open page — Main IS the home screen, guest-visible ─────────
    Open_App:
        zOpen: zSpark
        zWait:
            selector: .zTeamVault-title
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Main_Copy:
        zAssert:
            dom:
                selector: .zTeamVault-intro
                contains: shared secrets

    # ── Guest tries the Vault directly — the gate bounces to Login ──────────
    #  ~Actions* renders as a numbered menu (same shape as CLI's zPick) —
    #  each row's visible text IS the block key name, not the inner zBtn's
    #  own label (03_navigation.md "menus": same option keys click in
    #  Bifrost) — so the row is found by its text, not a data-zkey button.
    Guest_Click_GoVault:
        zClick:
            selector: "text=GoVault"
        zWait:
            selector: .zTeamVault-govault-btn
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    #> picking the menu row only drills into its content — the inner zBtn
    #  still needs its own click, same two-step shape as CLI's zPick + confirm <#
    Confirm_GoVault:
        zClick:
            selector: .zTeamVault-govault-btn
        zWait:
            selector: .zTeamVault-login-title
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Bounced_To_Login:
        zAssert:
            dom:
                selector: body
                contains: Sign in to Team Vault

    # ── Sign in as the seeded member — lands on the Vault, secrets show ─────
    Fill_Login_Member:
        zFill:
            email:    member@teamvault.io
            password: vault123
        zWait:
            selector: .zTeamVault-vault-title
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Vault_Renders:
        zAssert:
            dom:
                selector: .zTeamVault-intro
                contains: every signed-in teammate

    Assert_Secret_Visible:
        zAssert:
            dom:
                selector: body
                contains: Wifi password

    # ── Sign out — the gate turns the session back into a guest ─────────────
    Sign_Out:
        zClick:
            selector: "[data-zkey='SignOut'] button"
        zWait:
            selector: .zTeamVault-title
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Back_On_Main:
        zAssert:
            dom:
                selector: .zTeamVault-intro
                contains: shared secrets

    Sign_Out_Again_Hits_Gate:
        zClick:
            selector: "text=GoVault"
        zWait:
            selector: .zTeamVault-govault-btn
            state: visible
            timeout: 8000

    Confirm_GoVault_Again:
        zClick:
            selector: .zTeamVault-govault-btn
        zWait:
            selector: .zTeamVault-login-title
            state: visible
            timeout: 8000

    Assert_Bounced_After_Logout:
        zAssert:
            dom:
                selector: body
                contains: Sign in to Team Vault

    # ── Shippable at all three viewports — Main is the home screen ──────────
    Shot_Desktop:
        zViewport: desktop
        zOpen: zSpark
        zWait:
            selector: .zTeamVault-title
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Shot_Tablet:
        zViewport: tablet
        zOpen: zSpark
        zWait:
            selector: .zTeamVault-title
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Shot_Mobile:
        zViewport: mobile
        zOpen: zSpark
        zWait:
            selector: .zTeamVault-title
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Done:
        zMarker: done
