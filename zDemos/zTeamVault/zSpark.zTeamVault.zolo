# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.

zSpark:
    title:     Team Vault
    zMode:     zBifrost
    zLog:      INFO
    zLogPath:  @.logs
    zVaFolder: @.zViews
    zVaFile:   zUI.zTeamVault
    zBlock:    Main
    zServer:
        enabled: true

zInfo:
    description: Golden reference — auth/RBAC demo, zLogin + zGate gated views
    tags: [zLogin, zGate, zRBAC, zData]
    author: zAgents
