# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# zDash panel — data source: zLoom/spools/zUI.Companies.zolo (companies reel).

Companies:
    zMeta:
        title:       Companies
        icon:        bi-building
        description: Companies your contacts belong to
        zSpool:      [companies]

    Header:
        zH1:
            label: Companies
            color: PRIMARY

    Card:
        _zClass: zCRM-card

        List:
            zList:
                source: %data.companies
                each:
                    Row:
                        _zClass: zCRM-row

                        Name:
                            zText:
                                content: %item.name
                                _zClass: zCRM-name

                        Detail:
                            zText:
                                content: %item.industry · %item.notes | default(no notes)
                                _zClass: zCRM-detail

                        Delete:
                            zBtn:
                                label:  bi-trash
                                _zClass: zCRM-delete
                                action:
                                    zModal:
                                        zDialog:
                                            title:  Delete %item.name?
                                            fields: []
                                            onSubmit:
                                                zData:
                                                    action: delete
                                                    model:  @.models.zSchema.Companies
                                                    where:  id = %item.id

    #> notes is v1.1.0 — added post-launch via `z migrate` (models/zSchema.
    #  Companies zMigrationVersion) — the dialog/insert wiring is unchanged
    #  shape for the pre-existing fields, notes just joins the list, same as
    #  any other field — a migration doesn't require a rewrite anywhere else <#
    Add:
        zBtn:
            label:  bi-plus-lg + Add Company
            color:  primary
            _zClass: zCRM-add
            action:
                zModal:
                    zDialog:
                        title:  Add Company
                        fields: [name, industry, notes]
                        onSubmit:
                            zData:
                                action: insert
                                model:  @.models.zSchema.Companies
                                data:
                                    name:     zConv.name
                                    industry: zConv.industry
                                    notes:    zConv.notes

    #> the relational payoff, done the documented way: a per-row cross-table
    #  label needs a JOIN (a %item loop can't reach a second table by
    #  itself), and a join's result hands straight to zTable — no custom
    #  wiring, just auto_join: true reading the FK straight off the schema <#
    DirectoryHeader:
        zH2:
            label: Company Directory
            color: PRIMARY

    DirectoryInfo:
        zMD:
            content: Every contact, joined to its company in one read — `auto_join: true` follows the `company_id` FK declared on Contacts.

    #> zData alone auto-draws as a table — no zTable wrapper, no zLoom/%data
    #  token needed (docs: "zTable draws, zData feeds" — describing zData's
    #  own auto-draw, not two wired blocks) <#
    DirectoryTable:
        zData:
            action:    read
            model:     @.models.zSchema.Contacts
            table:     Contacts
            tables:    [Contacts, Companies]
            auto_join: true
            fields:    [Contacts.name, Contacts.email, Companies.name, Companies.industry]
            order_by:  Contacts.id ASC

    Refresh:
        zBtn:
            label:  bi-arrow-clockwise + Refresh
            color:  secondary
            _zClass: zCRM-refresh
            action: zDelta($Companies)
