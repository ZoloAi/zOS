# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# zDash panel — one of Contacts/Companies/Pipeline/Dashboard assembled by the
# root zUI.zCRM.zolo shell. A panel is ORDINARY Grammar (16_dashboards.md
# "body — ordinary Grammar; a panel renders fine standalone") — data source:
# zLoom/spools/zUI.Contacts.zolo (contacts reel), opted in via THIS panel's
# OWN zMeta.zSpool (16_dashboards.md golden note — panel-scoped, not root).

Contacts:
    zMeta:
        title:       Contacts
        icon:        bi-person-lines-fill
        description: Your contact list
        zSpool:      [contacts]

    Header:
        zH1:
            label: Contacts
            color: PRIMARY

    #> the list IS the panel body (no "List Contacts" button first); each row
    #  carries its OWN id (%item.id, baked in per-row by zList) for its action
    #  buttons — same canonical shape as zTaskList's Main <#
    Card:
        _zClass: zCRM-card

        List:
            zList:
                source: %data.contacts
                each:
                    Row:
                        _zClass: zCRM-row

                        Name:
                            zText:
                                content: %item.name
                                _zClass: zCRM-name

                        #> company_id is the FK — a raw id here on purpose (a
                        #  per-row cross-table label needs a join, and a join
                        #  feeds zTable, not a %item loop — see Companies
                        #  panel's Directory for the company NAME, joined) <#
                        Detail:
                            zText:
                                content: Company #%item.company_id | default(unassigned) · %item.email
                                _zClass: zCRM-detail

                        #> per_row (08_data_crud.md): a bare zBtn.action can't
                        #  carry a full zData block — a zModal + zDialog
                        #  (fields: []) onSubmit IS a full dispatch, no plugin
                        #  needed (same shape zShop uses for every one-click
                        #  cart mutation) <#
                        Delete:
                            zBtn:
                                label:  bi-trash
                                _zClass: zCRM-delete
                                action:
                                    zModal:
                                        zDialog:
                                            title:  Delete %item.name?
                                            fields: []
                                            onSubmit:
                                                zData:
                                                    action: delete
                                                    model:  @.models.zSchema.Contacts
                                                    where:  id = %item.id

    #> zModal + zDialog WITH real fields (not just fields: [] confirm) is the
    #  proven shape (07_forms.md "!page_dialog_key" note, zBlog's AddComment)
    #  — no separate Add_Contact page/zDelta hop needed. A standalone
    #  (non-%item) zModal button DID need a framework fix to get here —
    #  zEngine's chunked walker was treating it as a wizard gate (no
    #  wizard_gate_submit ever resumes it, since zModal is fire-and-forget
    #  like zDelta/zLink) and silently swallowing the click; zModal now joins
    #  that same non-gating set (zstride.py _NAV_ACTION_KEYS) <#
    Add:
        zBtn:
            label:  bi-plus-lg + Add Contact
            color:  primary
            _zClass: zCRM-add
            action:
                zModal:
                    zDialog:
                        title:  Add Contact
                        fields: [name, email, phone, company_id]
                        onSubmit:
                            zData:
                                action: insert
                                model:  @.models.zSchema.Contacts
                                data:
                                    name:       zConv.name
                                    email:      zConv.email
                                    phone:      zConv.phone
                                    company_id: zConv.company_id

    #> a zModal detour is trail-invisible by design (08_data_crud.md per_row
    #  "gotcha") — this self-hop zDelta is the next real navigation that
    #  re-runs prepare_block_render, same fix zPoll/zTaskList/Pipeline use <#
    Refresh:
        zBtn:
            label:  bi-arrow-clockwise + Refresh
            color:  secondary
            _zClass: zCRM-refresh
            action: zDelta($Contacts)
