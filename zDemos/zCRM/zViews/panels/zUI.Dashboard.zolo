# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# zDash panel — capstone dogfood segment 3: the dashboard. No group_by -> a
# bare SCALAR (18_data_advanced.md aggregate "shape"), read straight off
# %data.<name>; the by-stage breakdown ADDS group_by, flipping the SAME
# action to a LIST of {stage, total_value} rows a zList can walk like any
# other read. Data source: zLoom/spools/zUI.Dashboard.zolo.

Dashboard:
    zMeta:
        title:       Dashboard
        icon:        bi-bar-chart
        description: Pipeline analytics — value, win rate, breakdown by stage
        zSpool:      [pipeline_total_value, total_deal_count, won_count, pipeline_by_stage]

    Header:
        zH1:
            label: Pipeline Dashboard
            color: PRIMARY

    Summary:
        _zClass: zCRM-dash-summary

        #> group each stat + its caption into ONE card block (own _zClass) —
        #  targeting a parent-of-a-class via a bare `> div` child selector
        #  proved fragile for Pipeline's row (the earlier :has() miss); an
        #  explicit wrapper key is the same fix that solved that <#
        TotalCard:
            _zClass: zCRM-dash-card-item

            TotalValue:
                zText:
                    #> a scalar aggregate over ZERO rows is NULL, not 0 — the
                    #  dye below guards the "no deals yet" case (18_data_advanced.md) <#
                    content: $%data.pipeline_total_value | default(0)
                    _zClass: zCRM-dash-stat

            TotalLabel:
                zText:
                    content: Total pipeline value across %data.total_deal_count | default(0) deals
                    _zClass: zCRM-dash-caption

        WinCard:
            _zClass: zCRM-dash-card-item

            #> zKnot is a SIBLING of content/_zClass, not nested inside
            #  content (17_dynamic_content.md, zPoll's Percent block) — split
            #  the COMPUTED number (needs a knot) from the literal wording (a
            #  plain `content:` mixes %tokens + text fine, zPoll's totals
            #  line) so neither zJoin's no-quotes-for-literals nor the %
            #  token sigil (a bare "% " with no name after it just stays
            #  literal text) get in the way <#
            WinRatePct:
                zText:
                    zKnot:
                        zRound: [{zMul: [{zDiv: [%data.won_count, %data.total_deal_count]}, 100]}, 0]
                    _zClass: zCRM-dash-stat

            WinRateLabel:
                zText:
                    content: % won (%data.won_count | default(0) of %data.total_deal_count | default(0) deals)
                    _zClass: zCRM-dash-caption

    #> zProgress: current/total -> a FILLED bar, no hand-set percentage
    #  (21_progress.md) — one bar per stage, proportion of the WHOLE
    #  pipeline value, first dogfood of zProgress outside a zWizard <#
    ByStage:
        _zClass: zCRM-dash-card

        List:
            zList:
                source: %data.pipeline_by_stage
                each:
                    Row:
                        _zClass: zCRM-dash-row

                        #> static: true (21_progress.md) — a SNAPSHOT bar, not
                        #  a live climb: N list rows would otherwise fight
                        #  over zCLI's default in-place \r-redraw line (each
                        #  overwrites the last, no newline until 100%) — a
                        #  gap only zCLI has (Bifrost draws one DOM node per
                        #  call); found + fixed dogfooding this capstone
                        #  (core/.../timebased_progress.py progress_bar now
                        #  also resolves %token current/total/label, which
                        #  were silently unresolved strings before) <#
                        Bar:
                            zProgress:
                                label:   %item.stage · $%item.total_value
                                current: %item.total_value
                                total:   %data.pipeline_total_value
                                color:   primary
                                static:  true
