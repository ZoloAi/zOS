# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# zDash panel — capstone dogfood segment 2: the sales pipeline. Each Deal
# points at a Contact (same FK shape as Contacts.company_id) — a raw id here
# on the interactive row (per_row actions need %item.id, a join can't feed a
# zList), the human-readable NAME lives on this panel's own Directory below
# (the SAME auto_join-fed zTable split Companies panel already established).
# Data source: zLoom/spools/zUI.Pipeline.zolo (deals reel).

Pipeline:
    zMeta:
        title:       Pipeline
        icon:        bi-graph-up
        description: Sales pipeline — deals by stage
        zSpool:      [deals]

    Header:
        zH1:
            label: Sales Pipeline
            color: PRIMARY

    Card:
        _zClass: zCRM-card

        List:
            zList:
                source: %data.deals
                each:
                    Row:
                        _zClass: zCRM-row

                        Name:
                            zText:
                                content: %item.title
                                _zClass: zCRM-name

                        Detail:
                            zText:
                                content: Contact #%item.contact_id | default(unassigned) · $%item.value
                                _zClass: zCRM-detail

                        Stage:
                            zText:
                                content: %item.stage
                                _zClass: zCRM-stage-badge

                        #> per_row (08_data_crud.md, "preferred") — each stage
                        #  move is an explicit LITERAL zData:update, no
                        #  plugin: a fixed vocabulary (models/zSchema.Deals.
                        #  zolo "stage") means "next stage" is just picking
                        #  the right button, never a computed transition <#
                        Actions:
                            _zClass: zCRM-stage-actions

                            Qualify:
                                zBtn:
                                    label:   Qualify
                                    _zClass: zCRM-stage-btn
                                    action:
                                        zModal:
                                            zDialog:
                                                title:  Mark "%item.title" Qualified?
                                                fields: []
                                                onSubmit:
                                                    zData:
                                                        action: update
                                                        model:  @.models.zSchema.Deals
                                                        where:  id = %item.id
                                                        data:
                                                            stage: Qualified

                            Propose:
                                zBtn:
                                    label:   Propose
                                    _zClass: zCRM-stage-btn
                                    action:
                                        zModal:
                                            zDialog:
                                                title:  Mark "%item.title" as Proposal?
                                                fields: []
                                                onSubmit:
                                                    zData:
                                                        action: update
                                                        model:  @.models.zSchema.Deals
                                                        where:  id = %item.id
                                                        data:
                                                            stage: Proposal

                            Win:
                                zBtn:
                                    label:   Win
                                    _zClass: zCRM-stage-btn
                                    action:
                                        zModal:
                                            zDialog:
                                                title:  Mark "%item.title" Won?
                                                fields: []
                                                onSubmit:
                                                    zData:
                                                        action: update
                                                        model:  @.models.zSchema.Deals
                                                        where:  id = %item.id
                                                        data:
                                                            stage: Won

                            Lose:
                                zBtn:
                                    label:   Lost
                                    _zClass: zCRM-lost-btn
                                    action:
                                        zModal:
                                            zDialog:
                                                title:  Mark "%item.title" Lost?
                                                fields: []
                                                onSubmit:
                                                    zData:
                                                        action: update
                                                        model:  @.models.zSchema.Deals
                                                        where:  id = %item.id
                                                        data:
                                                            stage: Lost

                        Delete:
                            zBtn:
                                label:  bi-trash
                                _zClass: zCRM-delete
                                action:
                                    zModal:
                                        zDialog:
                                            title:  Delete "%item.title"?
                                            fields: []
                                            onSubmit:
                                                zData:
                                                    action: delete
                                                    model:  @.models.zSchema.Deals
                                                    where:  id = %item.id

    Add:
        zBtn:
            label:  bi-plus-lg + Add Deal
            color:  primary
            _zClass: zCRM-add
            action:
                zModal:
                    zDialog:
                        title:  Add Deal
                        fields: [title, contact_id, value]
                        onSubmit:
                            zData:
                                action: insert
                                model:  @.models.zSchema.Deals
                                data:
                                    title:      zConv.title
                                    contact_id: zConv.contact_id
                                    value:      zConv.value

    #> the SAME relational payoff as Companies' Directory, joined to a
    #  DIFFERENT table (Deals instead of Contacts) via the SAME auto_join: true <#
    DirectoryHeader:
        zH2:
            label: Pipeline Directory
            color: PRIMARY

    DirectoryInfo:
        zMD:
            content: Every deal, joined to its contact in one read — `auto_join: true` follows the `contact_id` FK declared on Deals.

    DirectoryTable:
        zData:
            action:    read
            model:     @.models.zSchema.Deals
            table:     Deals
            tables:    [Deals, Contacts]
            auto_join: true
            fields:    [Deals.title, Deals.stage, Deals.value, Contacts.name]
            order_by:  Deals.id ASC

    #> a zModal detour is trail-invisible by design (08_data_crud.md per_row
    #  "gotcha") — this self-hop zDelta is the next real navigation that
    #  re-runs prepare_block_render, same fix zPoll/zTaskList's Refresh use <#
    Refresh:
        zBtn:
            label:  bi-arrow-clockwise + Refresh
            color:  secondary
            _zClass: zCRM-refresh
            action: zDelta($Pipeline)
