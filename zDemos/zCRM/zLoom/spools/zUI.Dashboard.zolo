# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.

#> capstone dogfood segment 3: the dashboard. No group_by -> a bare SCALAR
#  (18_data_advanced.md aggregate "shape"), read straight as %data.<name>,
#  never a `.0.<field>` row <#
pipeline_total_value:
    zData:
        action:   aggregate
        model:    @.models.zSchema.Deals
        function: sum
        field:    value

total_deal_count:
    zData:
        action:   aggregate
        model:    @.models.zSchema.Deals
        function: count
        field:    id

won_count:
    zData:
        action:   aggregate
        model:    @.models.zSchema.Deals
        function: count
        field:    id
        where:
            stage: Won

#> group_by flips the shape to a LIST of {stage, total_value} rows
#  (18_data_advanced.md) — reads straight into a zList like any other <#
pipeline_by_stage:
    zData:
        action:   aggregate
        model:    @.models.zSchema.Deals
        function: sum
        field:    value
        alias:    total_value
        group_by: stage
