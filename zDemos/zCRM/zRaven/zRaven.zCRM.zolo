# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# zRavenVersion: v1.0.0
# Generated by:  z raven --gen
# Source:        zUI.zCRM.zolo
# Re-run z raven --gen to regenerate structural tests.
# Hand-tuned form values (zFill fields, zSubmit) are preserved across --gen.
# The previous version is archived to zVersions/tests/ (replay: z raven --run --r N).
#
# capstone segment 4: the WHOLE app is now a zDash console shell (16_dashboards.md,
# golden zDemos/zConsole) — Contacts/Companies/Pipeline/Dashboard are panels under
# zViews/panels/, switched via the sidebar/numbered-menu, never zDelta page-hops.

Tests:

    # ── Open: Contacts is the default panel ──────────────────────────────────
    Open_App:
        zOpen: zSpark
        zWait:
            selector: .zDash-container
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Contacts_Default:
        zAssert:
            dom:
                selector: .zTab-pane.zActive
                contains: Contacts

    Assert_Seed_Rows:
        zAssert:
            dom:
                selector: .zTab-pane.zActive .zCRM-row
                count: 3
            contains: Ada Lovelace

    # ── Add a contact, linked to a company via its FK field (zModal+zDialog
    #    WITH real fields — 07_forms.md "!page_dialog_key", zBlog's AddComment) ─
    Click_Add_Contact:
        zClick:
            selector: ".zTab-pane.zActive [data-zkey='Add'] button"
        zWait:
            selector: .zModal-overlay
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Fill_Add_Contact_Form:
        zFill:
            name:       Margaret Hamilton
            email:      margaret@acme.test
            phone:      555-0199
            company_id: 1
        zShot:
            full_page: true

    Submit_Add_Contact:
        zClick:
            selector: ".zModal-overlay button[type='submit']"

    Close_Add_Contact:
        zClick:
            selector: .zModal-close
        zWait:
            selector: .zModal-overlay
            state: hidden
            timeout: 8000

    #> a zModal detour is trail-invisible (08_data_crud.md per_row "gotcha") —
    #  the Refresh self-hop is the next real navigation that re-runs
    #  prepare_block_render on the panel <#
    Click_Contacts_Refresh:
        zClick:
            selector: ".zTab-pane.zActive [data-zkey='Refresh'] button"
        zWait:
            selector: .zTab-pane.zActive .zCRM-card
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Row_Added:
        zAssert:
            dom:
                selector: .zTab-pane.zActive .zCRM-row
                count: 4

    Assert_New_Row_Company:
        zAssert:
            dom:
                selector: ".zTab-pane.zActive .zCRM-row:has-text('Margaret Hamilton') .zCRM-detail"
                contains: Company #1

    # ── Delete the row just added ─────────────────────────────────────────────
    Click_Delete_New_Row:
        zClick:
            selector: ".zTab-pane.zActive .zCRM-row:has-text('Margaret Hamilton') .zCRM-delete"
        zWait:
            selector: .zModal-overlay
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Confirm_Delete_New_Row:
        zClick:
            selector: ".zModal-overlay button[type='submit']"

    Close_Delete_New_Row:
        zClick:
            selector: .zModal-close
        zWait:
            selector: .zModal-overlay
            state: hidden
            timeout: 8000

    # ── Companies: manage the OTHER side of the relationship, via the sidebar ──
    Dash_Pick_Companies:
        zPick: Companies
    #> a bare `contains` checks the last WS response (would coincidentally
    #  match the echoed {option: 'Companies'}, never the live page) — `dom:`
    #  reads the ACTIVE tab pane's real rendered text (zConsole's own note) <#
    Assert_Companies:
        zAssert:
            dom:
                selector: .zTab-pane.zActive
                contains: Companies

    #> the Contacts detour above (Refresh) already re-ran prepare_block_render
    #  on that panel — the delete is settled before we ever leave it <#
    Assert_Row_Gone:
        zAssert:
            dom:
                selector: .zTab-pane.zActive
                not_contains: Margaret Hamilton

    Assert_Company_Rows:
        zAssert:
            dom:
                selector: .zTab-pane.zActive .zCRM-row
                count: 2

    Click_Add_Company:
        zClick:
            selector: ".zTab-pane.zActive [data-zkey='Add'] button"
        zWait:
            selector: .zModal-overlay
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Fill_Add_Company_Form:
        zFill:
            name:     Initech
            industry: Software
            notes:    Prospect, met at zConf 2026
        zShot:
            full_page: true

    Submit_Add_Company:
        zClick:
            selector: ".zModal-overlay button[type='submit']"

    Close_Add_Company:
        zClick:
            selector: .zModal-close
        zWait:
            selector: .zModal-overlay
            state: hidden
            timeout: 8000

    Click_Companies_Refresh:
        zClick:
            selector: ".zTab-pane.zActive [data-zkey='Refresh'] button"
        zWait:
            selector: .zTab-pane.zActive .zCRM-card
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Company_Added:
        zAssert:
            dom:
                selector: .zTab-pane.zActive .zCRM-row
                count: 3

    # ── Company Directory now lives ON the Companies panel — auto_join'd table ─
    Assert_Directory_Joined:
        zAssert:
            dom:
                selector: .zTab-pane.zActive table
                contains: Acme Corp

    # ── Pipeline: capstone segment 2 — literal stage transitions, a SECOND
    #    FK (contact_id), its OWN auto_join'd directory ────────────────────────
    Dash_Pick_Pipeline:
        zPick: Pipeline
    Assert_Pipeline:
        zAssert:
            dom:
                selector: .zTab-pane.zActive
                contains: Sales Pipeline

    Assert_Deal_Rows:
        zAssert:
            dom:
                selector: .zTab-pane.zActive .zCRM-row
                count: 4
            contains: Acme Corp - Q3 Renewal

    # ── Add a deal, linked to a contact via its FK field ─────────────────────
    Click_Add_Deal:
        zClick:
            selector: ".zTab-pane.zActive [data-zkey='Add'] button"
        zWait:
            selector: .zModal-overlay
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Fill_Add_Deal_Form:
        zFill:
            title:      Test Deal
            contact_id: 1
            value:      1000
        zShot:
            full_page: true

    Submit_Add_Deal:
        zClick:
            selector: ".zModal-overlay button[type='submit']"

    Close_Add_Deal:
        zClick:
            selector: .zModal-close
        zWait:
            selector: .zModal-overlay
            state: hidden
            timeout: 8000

    Click_Pipeline_Refresh:
        zClick:
            selector: ".zTab-pane.zActive [data-zkey='Refresh'] button"
        zWait:
            selector: .zTab-pane.zActive .zCRM-card
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Deal_Added:
        zAssert:
            dom:
                selector: .zTab-pane.zActive .zCRM-row
                count: 5

    #> per_row literal stage move (08_data_crud.md) — a fixed vocabulary
    #  button, not a computed transition, so no plugin is needed <#
    Click_Qualify_Test_Deal:
        zClick:
            selector: ".zTab-pane.zActive .zCRM-row:has-text('Test Deal') button:has-text('Qualify')"
        zWait:
            selector: .zModal-overlay
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Confirm_Qualify_Test_Deal:
        zClick:
            selector: ".zModal-overlay button[type='submit']"

    Close_Qualify_Test_Deal:
        zClick:
            selector: .zModal-close
        zWait:
            selector: .zModal-overlay
            state: hidden
            timeout: 8000

    Click_Refresh_2:
        zClick:
            selector: ".zTab-pane.zActive [data-zkey='Refresh'] button"
        zWait:
            selector: .zTab-pane.zActive .zCRM-card
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    #> .zCRM-stage-badge is text-transform: uppercase in CSS — the rendered
    #  innerText is visually UPPERCASE even though zData stores "Qualified" <#
    Assert_Test_Deal_Qualified:
        zAssert:
            dom:
                selector: ".zTab-pane.zActive .zCRM-row:has-text('Test Deal') .zCRM-stage-badge"
                contains: QUALIFIED

    # ── Delete the deal just added ────────────────────────────────────────────
    Click_Delete_Test_Deal:
        zClick:
            selector: ".zTab-pane.zActive .zCRM-row:has-text('Test Deal') .zCRM-delete"
        zWait:
            selector: .zModal-overlay
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Confirm_Delete_Test_Deal:
        zClick:
            selector: ".zModal-overlay button[type='submit']"

    Close_Delete_Test_Deal:
        zClick:
            selector: .zModal-close
        zWait:
            selector: .zModal-overlay
            state: hidden
            timeout: 8000

    Click_Refresh_3:
        zClick:
            selector: ".zTab-pane.zActive [data-zkey='Refresh'] button"
        zWait:
            selector: .zTab-pane.zActive .zCRM-card
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Test_Deal_Gone:
        zAssert:
            dom:
                selector: .zTab-pane.zActive
                not_contains: Test Deal

    # ── Pipeline Directory now lives ON the Pipeline panel — SECOND auto_join ──
    Assert_Pipeline_Directory_Joined:
        zAssert:
            dom:
                selector: .zTab-pane.zActive table
                contains: Ada Lovelace

    Assert_Pipeline_Directory_Has_Deal:
        zAssert:
            dom:
                selector: .zTab-pane.zActive table
                contains: Globex Onboarding

    # ── Dashboard: capstone segment 3 — aggregate scalars + a group_by list
    #    fed to zProgress bars (first dogfood of zProgress outside a zWizard) ──
    Dash_Pick_Dashboard:
        zPick: Dashboard
    Assert_Dashboard:
        zAssert:
            dom:
                selector: .zTab-pane.zActive
                contains: Pipeline Dashboard
        zShot:
            full_page: true

    #> 4 seeded deals: 18000+9500+32000+5000 = 64500 total, 1 Won of 4 -> 25% ──
    Assert_Dashboard_Total_Value:
        zAssert:
            dom:
                selector: .zTab-pane.zActive .zCRM-dash-summary
                contains: 64500

    Assert_Dashboard_Win_Rate:
        zAssert:
            dom:
                selector: .zTab-pane.zActive .zCRM-dash-summary
                contains: 25

    Assert_Dashboard_Win_Rate_Label:
        zAssert:
            dom:
                selector: .zTab-pane.zActive .zCRM-dash-summary
                contains: won (1 of 4 deals)

    Assert_Dashboard_Stage_Bars:
        zAssert:
            dom:
                selector: .zTab-pane.zActive .zProgress
                count: 4

    Assert_Dashboard_Stage_Label:
        zAssert:
            dom:
                selector: .zTab-pane.zActive .zCRM-dash-card
                contains: Proposal

    # ── Shippable at all three viewports ─────────────────────────────────────
    Shot_Desktop:
        zViewport: desktop
        zOpen: zSpark
        zWait:
            selector: .zDash-container
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Shot_Tablet:
        zViewport: tablet
        zOpen: zSpark
        zWait:
            selector: .zDash-container
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Shot_Mobile:
        zViewport: mobile
        zOpen: zSpark
        zWait:
            selector: .zDash-container
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Done:
        zMarker: done
