# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
#
# zProject — distribution manifest for `zolo push` (see zLedger's for the
# annotated reference). Ships everything minus ignore; zCloud wakes `spark`.

zProject:
    slug:       ztasklist
    name:       zTaskList
    spark:      zSpark.ztasklist.zolo
    version:    1.0.0
    visibility: public
    tagline:    A consumer task list — canonical zData CRUD with zList per-row actions
    tags:       [productivity, crud, reference]
    cover:      cover.png
    #> golden-demo convention: SHIP the zRaven test file as teaching material,
    #  prune only run artifacts. Data/ ships (seed rows ARE the demo). The
    #  `_zSpark.add_task.zolo` dev spark + its raven stay in the repo as the
    #  dev_spark teaching example but never ship — scratch tooling, not app. <#
    ignore:
        - logs/*
        - zRaven/output/*
        - zRaven/zShots/*
        - zRaven/zRaven.add_task.zolo
        - zVersions/*
        - _zSpark.*
        - "*.db-journal"
        - .zpush_*
        - cover.png   #> rides the multipart, not the app/ slice <#
