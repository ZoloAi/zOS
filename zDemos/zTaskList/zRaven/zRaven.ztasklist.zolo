# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# zRavenVersion: v1.0.0
# Generated by:  z raven --gen (structural Open_App only)
# Source:        zUI.ztasklist.zolo
# Hand-tuned CRUD steps + a zShot after every action live on top of --gen —
# per project rule: screenshot every Bifrost step, always, no exceptions.

Tests:

    # ── Bifrost: open page — the list IS the home screen ────────────────────
    Open_App:
        zOpen: zSpark
        zWait:
            selector: .zTaskList-card
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Seed_Rows:
        zAssert:
            dom:
                selector: .zTaskList-row
                count: 3
        zShot:
            full_page: true

    # ── Add: no typed id, just a title ──────────────────────────────────────
    Pick_Add:
        zClick:
            selector: "[data-zkey='Add'] button"
        zShot:
            full_page: true

    Fill_Add_Form:
        zFill:
            title: Buy groceries
        zShot:
            full_page: true

    Back_From_Add:
        zClick:
            selector: "[data-zkey='Back'] button"
        zShot:
            full_page: true

    Assert_Row_Added:
        zAssert:
            dom:
                selector: .zTaskList-row
                count: 4
        zShot:
            full_page: true

    Assert_New_Row_Unchecked:
        zAssert:
            dom:
                selector: ".zTaskList-row:has-text('Buy groceries') [data-zkey='Toggle']"
                property: className
                contains: zTaskList-toggle-False

    # ── Toggle: tap the circle beside the row, no id typed ───────────────────
    Click_Toggle_New_Row:
        zClick:
            selector: ".zTaskList-row:has-text('Buy groceries') [data-zkey='Toggle']"
        zShot:
            full_page: true

    Wait_Toggle_Reload:
        zWait:
            selector: ".zTaskList-row:has-text('Buy groceries') .zTaskList-toggle-True"
            state: visible
            timeout: 6000

    Assert_Toggle_Done:
        zAssert:
            dom:
                selector: ".zTaskList-row:has-text('Buy groceries') .zTaskList-title-True"
                contains: Buy groceries
        zShot:
            full_page: true

    # ── Delete: zModal + zDialog(fields: []) onSubmit holds a real zData
    #    block directly (08_data_crud.md per_row "preferred"), no plugin ────
    Click_Delete_New_Row:
        zClick:
            selector: ".zTaskList-row:has-text('Buy groceries') .zTaskList-delete"
        zWait:
            selector: .zModal-overlay
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Confirm_Delete_New_Row:
        zClick:
            selector: ".zModal-overlay button[type='submit']"

    Close_Delete_New_Row:
        zClick:
            selector: .zModal-close
        zWait:
            selector: .zModal-overlay
            state: hidden
            timeout: 8000

    #> a zModal detour is trail-invisible (08_data_crud.md per_row "gotcha")
    #  — Refresh is the next real navigation (self-hop zDelta) that picks
    #  up the post-delete row set <#
    Click_Refresh:
        zClick:
            selector: "[data-zkey='Refresh'] button"
        zWait:
            selector: .zTaskList-card
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Row_Gone:
        zAssert:
            dom:
                not_contains: Buy groceries
        zShot:
            full_page: true

    # ── Shots: the shippable bar — 3 viewports of the live task list ────────
    Shot_Desktop:
        zViewport: desktop
        zOpen: zSpark
        zWait:
            selector: .zTaskList-card
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Shot_Tablet:
        zViewport: tablet
        zOpen: zSpark
        zWait:
            selector: .zTaskList-card
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Shot_Mobile:
        zViewport: mobile
        zOpen: zSpark
        zWait:
            selector: .zTaskList-card
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Done:
        zMarker: done
