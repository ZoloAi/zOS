# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.

zSpark:
    title:     zBooking
    zMode:     zBifrost
    zLog:      INFO
    zLogPath:  @.logs
    zVaFolder: @.zViews
    zVaFile:   zUI.zBooking
    zBlock:    Main
    zServer:
        enabled: true

zInfo:
    description: Golden reference — booking/scheduling app, zero plugins — availability is a derived zNotExists read, conflict validation is a unique constraint
    tags: [zData, zSchema, foreign_key, zDialog, zModal, unique_constraint, zNotExists]
    author: zAgents
