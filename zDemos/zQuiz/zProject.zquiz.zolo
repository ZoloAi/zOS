# .zolo — zOS UI language. NOT YAML. String-first by default: no quotes unless : { # present.
#
# zProject — distribution manifest for `zolo push` (see zLedger's for the
# annotated reference). Ships everything minus ignore; zCloud wakes `spark`.

zProject:
    slug:       zquiz
    name:       zQuiz
    spark:      zSpark.zQuiz.zolo
    version:    1.0.0
    visibility: public
    tagline:    Test yourself — a declarative quiz engine in pure zolo
    tags:       [games, learning]
    cover:      cover.png
    #> golden-demo convention (zHello/zSciCalc): SHIP the zRaven test file as
    #  teaching material, prune only run artifacts — and note the globs:
    #  bare dir names segment-match whole trees, `dir/*` prunes contents. <#
    ignore:
        - logs/*
        - zRaven/output/*
        - zRaven/zShots/*
        - zVersions/*
        - .zpush_*
        - cover.png   #> rides the multipart, not the app/ slice <#
