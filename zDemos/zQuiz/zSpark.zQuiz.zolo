# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.

zSpark:
    title:     Quiz
    zMode:     zBifrost
    zLog:      INFO
    zLogPath:  @.logs
    zVaFolder: @.zViews
    zVaFile:   zUI.zquiz
    zBlock:    Main
    zServer:
        enabled: true

zInfo:
    description: Golden reference — branching quiz/survey engine, zWizard + zHat + zGate scoring
    tags: [zWizard, zHat, zGate, zFunc]
    author: zAgents
