# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# zRavenVersion: v1.0.0
# Generated by:  z raven --gen (structural skeleton only — wizard flow hand-tuned)
# Source:        zUI.zquiz.zolo
# Re-run z raven --gen to refresh the structural skeleton; this file's
# hand-authored browser flow (zClick/zFill/zAssert) is NOT auto-generated —
# no golden app yet combines zWizard + zSelect + Bifrost browser assertions,
# so this IS the reference pattern (11_wizard.md / 06_inputs.md).

Tests:

    # ── Bifrost: open page — Track picker IS the home screen ────────────────
    Open_App:
        zOpen: zSpark
        zWait:
            selector: .zQuiz-title
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Track_Prompt:
        zAssert:
            dom:
                selector: "[data-zkey='Track']"
                contains: Choose your track

    # ── Beginner track: Q1 right, Q2 wrong -> 2/3 (67%) ──────────────────────
    Pick_Beginner:
        zClick:
            selector: "[data-zkey='Track'] input[value='Beginner']"
        zShot:
            full_page: true

    Start_Beginner:
        zClick:
            selector: "[data-zkey='Track_Next']"
        zWait:
            selector: "[data-zkey='Q1']"
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Q1_Prompt:
        zAssert:
            dom:
                selector: "[data-zkey='Q1']"
                contains: capital of France

    Answer_Q1_Beginner:
        zClick:
            selector: "[data-zkey='Q1'] input[value='Paris']"

    Next_Q1_Beginner:
        zClick:
            selector: "[data-zkey='Q1_Next']"
        zWait:
            selector: "[data-zkey='Q2']"
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Answer_Q2_Beginner:
        zClick:
            selector: "[data-zkey='Q2'] input[value='5']"

    Next_Q2_Beginner:
        zClick:
            selector: "[data-zkey='Q2_Next']"
        zWait:
            selector: "[data-zkey='Show_Results']"
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Beginner_Score:
        zAssert:
            dom:
                selector: "[data-zkey='Show_Results']"
                contains: Score: 2/3 (67%)

    Retake_Beginner:
        zClick:
            selector: "[data-zkey='Retake']"
        zWait:
            selector: "[data-zkey='Track']"
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    # ── Advanced track: everything right -> 8/8 (100%), gated Q3/Q4 appear ───
    # Fresh reload (not a Retake continuation) — Retake's DOM-reuse quirk on the
    # already-disabled Track_Next button is a separate loop-back concern from
    # the branching/scoring flow under test here.
    Reload_For_Advanced:
        zOpen: zSpark
        zWait:
            selector: .zQuiz-title
            state: visible
            timeout: 8000

    Pick_Advanced:
        zClick:
            selector: "[data-zkey='Track'] input[value='Advanced']"

    Start_Advanced:
        zClick:
            selector: "[data-zkey='Track_Next']"
        zWait:
            selector: "[data-zkey='Q1']"
            state: visible
            timeout: 8000

    Answer_Q1_Advanced:
        zClick:
            selector: "[data-zkey='Q1'] input[value='Paris']"

    Next_Q1_Advanced:
        zClick:
            selector: "[data-zkey='Q1_Next']"
        zWait:
            selector: "[data-zkey='Q2']"
            state: visible
            timeout: 8000

    Answer_Q2_Advanced:
        zClick:
            selector: "[data-zkey='Q2'] input[value='4']"

    Next_Q2_Advanced:
        zClick:
            selector: "[data-zkey='Q2_Next']"
        zWait:
            selector: "[data-zkey='Q3']"
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Q3_Prompt:
        zAssert:
            dom:
                selector: "[data-zkey='Q3']"
                contains: square root of 144

    Answer_Q3_Advanced:
        zClick:
            selector: "[data-zkey='Q3'] input[value='12']"

    Next_Q3_Advanced:
        zClick:
            selector: "[data-zkey='Q3_Next']"
        zWait:
            selector: "[data-zkey='Q4']"
            state: visible
            timeout: 8000

    Assert_Q4_Prompt:
        zAssert:
            dom:
                selector: "[data-zkey='Q4']"
                contains: Red Planet

    Answer_Q4_Advanced:
        zClick:
            selector: "[data-zkey='Q4'] input[value='Mars']"

    Next_Q4_Advanced:
        zClick:
            selector: "[data-zkey='Q4_Next']"
        zWait:
            selector: "[data-zkey='Show_Results']"
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Advanced_Score:
        zAssert:
            dom:
                selector: "[data-zkey='Show_Results']"
                contains: Score: 8/8 (100%)

    # ── Shippable at all three viewports — Track picker is the home screen ──
    Shot_Desktop:
        zViewport: desktop
        zOpen: zSpark
        zWait:
            selector: .zQuiz-title
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Shot_Tablet:
        zViewport: tablet
        zOpen: zSpark
        zWait:
            selector: .zQuiz-title
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Shot_Mobile:
        zViewport: mobile
        zOpen: zSpark
        zWait:
            selector: .zQuiz-title
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Done:
        zMarker: done
