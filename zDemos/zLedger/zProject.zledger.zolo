# .zolo — zOS UI language. NOT YAML. String-first by default: no quotes unless : { # present.
#
# zProject — the DISTRIBUTION manifest `zolo push` ships. Everything under this
# folder minus `ignore` becomes the hosted app/ slice; zCloud wakes `spark`.
#
# WHY the ignores:
#   • zEnv.development.zolo — machine-local dev mount (absolute path to a
#     zbifrost-client working tree). Hosted instances must fall back to the
#     pinned CDN client, so the dev env NEVER ships.
#   • zRaven/ + logs/ — test harness and run artifacts; dormant weight only.
#   • *.db-journal / zShots — sqlite scratch + raven screenshots.
# Data/ DOES ship: the seeded ledger (csv + migrated sqlite) IS the demo.

zProject:
    slug:       zledger
    name:       zLedger
    spark:      zSpark.zLedger.zolo
    version:    1.0.0
    visibility: public
    #> feed-card meta — manifest-authoritative on every push (zpush.py);
    #  absent keys leave the zApps columns alone (dashboard edits survive). <#
    tagline:    Live search · soft-delete · aggregates — the golden data-table reference
    tags:       [tools, data, reference]
    #> the feed-card photo — ships as its own multipart part beside the bundle
    #  (served blob, not app code), lands as zApps.cover_key. Omit it and the
    #  server generates a slug-seeded default (a card photo is a requirement). <#
    cover:      cover.png
    #> golden-demo convention (zHello/zSciCalc/zQuiz): SHIP the zRaven test
    #  file as teaching material, prune only run artifacts. <#
    ignore:
        - zEnv.development.zolo
        - logs/*
        - zRaven/output/*
        - zRaven/zShots/*
        - "*.db-journal"
        - .zpush_*
        - cover.png   #> rides the multipart, not the app/ slice <#
