# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# zRavenVersion: v1.0.0
# Source: zUI.Login.zolo + zUI.ForgotPassword.zolo + zUI.ResetPassword.zolo
# Hand-extended — dev flow (13_testing.md dev_spark) for the forgot/reset-
# password grammar, sibling to zRaven.verify_email.zolo's token+expiry+
# single-use flow: Login's new ForgotPasswordLink → request a reset for a
# KNOWN email and an UNKNOWN one (same generic message either way — never
# reveal registration status) → the seeded /ResetPassword/%token route
# itself (Frank's fixture, same shape as Verify's seeded-test-token-abc123)
# → set a new password → sign in with the NEW password to prove the write
# actually landed → the stale/invalid-token 404 guard.

Tests:

    # ── Entry point — Login's new ForgotPasswordLink ────────────────────────
    Open_App:
        zOpen: zSpark
        zWait:
            selector: .zRM-login-title
            state: visible
            timeout: 8000

    Click_Forgot_Password_Link:
        zClick:
            selector: "[data-zkey='ForgotPasswordLink'] button"
        zWait:
            selector: .zRM-title
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Forgot_Password_Title:
        zAssert:
            dom:
                selector: .zRM-title
                contains: Forgot your password

    # ── Known email — the real branch, silently stamps a fresh token ────────
    Fill_Known_Email:
        zFill:
            email: ada@zrm.io
        zShot:
            full_page: true

    Submit_Known_Email:
        zClick:
            selector: "button[type='submit']"
        zWait:
            selector: .zSignal-success
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Known_Email_Message:
        zAssert:
            dom:
                selector: .zSignal-success
                contains: on its way

    #> privacy guard — an email that matches ZERO rows returns the exact
    #  SAME message (request_password_reset's own "never reveal whether an
    #  email is registered" branch), proven by reloading the page fresh and
    #  repeating with a nonexistent address <#
    Reload_Forgot_Password:
        zOpen: zSpark
        zWait:
            selector: .zRM-login-title
            state: visible
            timeout: 8000

    Reopen_Forgot_Password:
        zClick:
            selector: "[data-zkey='ForgotPasswordLink'] button"
        zWait:
            selector: .zRM-title
            state: visible
            timeout: 8000

    Fill_Unknown_Email:
        zFill:
            email: nobody@zrm.io

    Submit_Unknown_Email:
        zClick:
            selector: "button[type='submit']"
        zWait:
            selector: .zSignal-success
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Unknown_Email_Same_Message:
        zAssert:
            dom:
                selector: .zSignal-success
                contains: on its way

    # ── The /ResetPassword/%token route's POSITIVE case ─────────────────────
    #> Frank is the SAME fixture zRaven.verify_email.zolo already leans on
    #  for its own seeded token — here carrying a second, independent
    #  reset_token/reset_token_expires_at pair (fixed, far-future expiry) so
    #  this path has a known-good token to navigate to directly, no need to
    #  intercept a dynamically emailed one <#
    Open_Seeded_Reset_Link:
        zOpen:
            type:  zLoom
            zLoom: @.zLoom.spools.zUI.ResetPassword.resetLookup
            params:
                token: seeded-reset-token-xyz789
        zWait:
            selector: .zRM-title
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Reset_Token_Title_Renders:
        zAssert:
            dom:
                selector: .zRM-title
                contains: Reset your password

    #> no separate Submit click — a zFill on a `type: password` field's Enter
    #  key auto-submits the form (same behavior Register's own Fill_Register_
    #  Form relies on, no explicit submit step there either); a second click
    #  on the SAME submit button afterward double-fires onSubmit with an
    #  already-cleared zConv (found the hard way building this exact step —
    #  password_len logged None on the second call) <#
    Fill_New_Password:
        zFill:
            password: frank-new-pw9
        zWait:
            selector: .zSignal-success
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Password_Updated_Message:
        zAssert:
            dom:
                selector: .zSignal-success
                contains: Password updated

    #> the real regression guard — reset_password's manual
    #  zos.auth.hash_password call (zHash doesn't auto-fire on a plugin-
    #  driven update, same gap register_user's own docstring already notes)
    #  actually landed a bcrypt hash zLogin can verify against <#
    Go_To_Sign_In:
        zClick:
            selector: ".zRM-signin-btn"
        zWait:
            selector: .zRM-login-title
            state: visible
            timeout: 8000

    Sign_In_With_New_Password:
        zFill:
            email:    frank@zrm.io
            password: frank-new-pw9
        zWait:
            selector: .zRM-feed
            state: visible
            timeout: 8000

    Assert_Signed_In_As_Frank:
        zAssert:
            dom:
                selector: .zRM-authbar-user
                contains: Frank

    # ── Invalid token — 404s via the spool's own "matches nothing" guard ────
    Open_Invalid_Reset_Link:
        zOpen:
            type:  zLoom
            zLoom: @.zLoom.spools.zUI.ResetPassword.resetLookup
            params:
                token: not-a-real-token
        zShot:
            full_page: true

    Assert_Invalid_Reset_Token_404:
        zAssert:
            dom:
                selector: body
                contains: 404

    Done:
        zMarker: done
