# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# Own file → own auto-discovered route (/ForgotPassword) — the signed-OUT
# entry point for the SAME request_password_reset plugin the Account panel's
# Security.ResetPasswordBtn already calls (zDemos/zRM/plugins/zrm.py),
# reachable when there's no session/Account panel to click it from at all.

zMeta:
    zBrush: [zrm]

ForgotPassword:
    zGate:
        authed: false
    onDenied:
        zLink: @.zViews.zUI.Profile.Profile

    zH1:
        label: Forgot your password?
        color: PRIMARY
        _zClass: zRM-title

    Hint:
        zText:
            content: Enter your account email and we'll send a reset link.
            _zClass: zRM-forgot-hint

    #> model omitted on purpose — `email` here is a lookup key, not a
    #  Users-row field being written (request_password_reset's own "never
    #  reveal whether an email is registered" branch reads, never inserts) <#
    zDialog:
        title:  Reset your password
        fields: [
            {zConv: email, type: str, label: Email},
        ]
        onSubmit:
            zFunc: &.zrm.request_password_reset(zConv.email)

    SignInLink:
        zBtn:
            label:  ← Back to Sign in
            color:  secondary
            _zClass: zRM-signin-link
            action: zLink(@.zViews.zUI.Login.Login)
