# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# Own file → own auto-discovered route ANCHOR (routes/zServer.routes.zolo
# maps /ResetPassword/%token here as a zLoom param route, 14_server.md
# "param") — same shape as zUI.Verify.zolo's VerifyToken block. No zGate —
# reachable signed-in OR signed-out (whichever browser holds the emailed
# link), nothing to gate on a password-reset step itself.

zMeta:
    zBrush: [zrm]
    zSpool: [resetLookup]

ResetToken:
    zH1:
        label: Reset your password
        color: PRIMARY
        _zClass: zRM-title

    #> the zLoom route's OWN spool already 404'd on a token matching zero
    #  rows — reaching this block at all means the row exists. model: gives
    #  the new-password field the SAME min_length:8 rule + masked input
    #  Register already uses (07_forms.md model-driven fields).
    #  core gap found building this page: a zDialog onSubmit ONLY resolves
    #  zConv.* and %session.* (dialog_submit.py's own _interpolate_session_
    #  values only matches an "%session." prefix) — %data.* / %route.* pass
    #  through onSubmit LITERALLY unresolved, unlike a bare block-level
    #  zFunc action (Verify's own Result block) where %data.* DOES resolve.
    #  Route the token through zConv itself instead: a readonly field whose
    #  `default:` is %data — that's a RENDER-time value (same mechanism any
    #  %data-driven zText/href already relies on, proven working), captured
    #  into zConv on submit exactly like any other typed field <#
    zDialog:
        title:  New password
        model:  @.models.zSchema.Users
        fields: [
            {zConv: token, type: str, label: Reset code, default: %data.resetLookup.0.reset_token, readonly: true, _zClass: zRM-reset-token-field},
            password,
        ]
        onSubmit:
            zFunc: &.zrm.reset_password(zConv.token, zConv.password)

    SignInLink:
        zBtn:
            label:  Go to Sign in
            color:  primary
            _zClass: zRM-signin-btn
            action: zLink(@.zViews.zUI.Login.Login)
