# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# Feeds the /ResetPassword/%token zLoom route (14_server.md "param") — same
# bare-existence-check shape as zUI.Verify.zolo's own `verify` spool. A token
# matching ZERO rows (never issued, already consumed, or hand-tampered) 404s
# automatically; reset_password re-checks expiry itself since a stale-but-
# unconsumed token DOES still match a row here.

resetLookup:
    zData:
        action: read
        model:  @.models.zSchema.Users
        table:  Users
        where:
            reset_token: %route.token
