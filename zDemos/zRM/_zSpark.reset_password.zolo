# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
#> dev/flow spark — NOT a first-class app entry point. Jumps zRaven straight
#  to Login (zBlock: Login, zVaFile: zUI.Login), skipping the Main→Login nav
#  hop, so the forgot/reset-password flow doesn't pay the full 50-step
#  canonical journey's nav tax every --run (13_testing.md dev_spark). Same
#  shape as _zSpark.verify_email.zolo's own dev flow for the sibling
#  token+expiry+single-use grammar. <#

zSpark:
    title:     zRM — Reset Password (dev flow)
    zMode:     zBifrost
    zLog:      DEBUG
    zLogPath:  @.logs
    zVaFolder: @.zViews
    zVaFile:   zUI.Login
    zBlock:    Login
    zServer:
        enabled: true
