# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# zRavenVersion: v1.0.0
# Generated by:  z raven --gen
# Source:        zUI.zgallery.zolo
# Re-run z raven --gen to regenerate structural tests.
# Hand-tuned form values (zFill fields, zSubmit) are preserved across --gen.
# The previous version is archived to zVersions/tests/ (replay: z raven --run --r N).

Tests:

    # ── Bifrost: open page — the grid IS the home screen ────────────────────
    Open_App:
        zOpen: zSpark
        zWait:
            selector: .zGallery-grid
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Seed_Rows:
        zAssert:
            dom:
                selector: .zGallery-card
                count: 6
            contains: Mountain Dawn

    # ── Edit a seed photo's details — zModal + zDialog (03_navigation.md) ───
    #  A dict action {zModal: {zDialog: ...}} opens a glance-and-return
    #  overlay, pre-filled from %item (baked in at zList expansion) <#
    Open_Edit_Dialog:
        zClick:
            selector: ".zGallery-card:has-text('Mountain Dawn') .zGallery-edit"
        zWait:
            selector: .zModal-overlay
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    #> zFill's own last-field click submits the enclosing form — same
    #  implicit "last field -> submit" contract Fill_Add_Form relies on <#
    Fill_Edit_Form:
        zFill:
            title:   Mountain Sunrise
            caption: Golden hour above the ridge, well after dawn.
        zShot:
            full_page: true

    Close_Edit_Dialog:
        zClick:
            selector: .zModal-close
        zWait:
            selector: .zModal-overlay
            state: hidden
            timeout: 8000
        zShot:
            full_page: true

    Reload_After_Edit:
        zOpen: zSpark
        zWait:
            selector: .zGallery-grid
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Title_Updated:
        zAssert:
            dom:
                selector: ".zGallery-card:has-text('Mountain Sunrise') .zGallery-title"
                contains: Mountain Sunrise

    Assert_Old_Title_Gone:
        zAssert:
            dom:
                selector: .zGallery-grid
                not_contains: Mountain Dawn

    # ── Add a photo: file input + zDialog collector (06_inputs + 07_forms) ──
    Pick_Add:
        zClick:
            selector: "[data-zkey='Add'] button"
        zWait:
            selector: "[name='photo']"
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    #> file BEFORE fields on purpose: _BIFROST_PRIMITIVE_ORDER runs zFill
    #  before zUpload inside one step, and zFill's own last-field click
    #  submits the form — the photo has to already be set when that fires,
    #  so this has to be its OWN step, ahead of Fill_Add_Form <#
    Upload_Photo_File:
        zUpload:
            selector: "[name='photo']"
            path: upload_bank/desert_dune.jpg
        zShot:
            full_page: true

    Fill_Add_Form:
        zFill:
            title:   Desert Dune
            caption: A quiet dune ridge cut by a single set of footprints.
        zShot:
            full_page: true

    Back_To_Main:
        zClick:
            selector: "[data-zkey='Back'] button"
        zWait:
            selector: .zGallery-grid
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Row_Added:
        zAssert:
            dom:
                selector: .zGallery-card
                count: 7

    Assert_New_Card_Title:
        zAssert:
            dom:
                selector: ".zGallery-card:has-text('Desert Dune') .zGallery-title"
                contains: Desert Dune

    # ── Delete the photo just added — per_row zBtn.action -> @zfunc ─────────
    #  The zfunc runs + drops the row immediately (toast confirms it), but a
    #  plain quiet &. action only reports a signal — it does not re-render
    #  the CURRENT block's own zList (same reason Add_Photo needed an
    #  explicit Back_To_Main hop to show its new row). A fresh zOpen reload
    #  is the same "re-dispatch the block" mechanism the viewport shots
    #  below already rely on, so it proves the delete truly persisted <#
    Delete_Photo:
        zClick:
            selector: ".zGallery-card:has-text('Desert Dune') .zGallery-delete"
        zShot:
            full_page: true

    Reload_After_Delete:
        zOpen: zSpark
        zWait:
            selector: .zGallery-grid
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Row_Deleted:
        zAssert:
            dom:
                selector: .zGallery-card
                count: 6

    Assert_Card_Gone:
        zAssert:
            dom:
                selector: .zGallery-grid
                not_contains: Desert Dune

    # ── Shippable at all three viewports ─────────────────────────────────────
    Shot_Desktop:
        zViewport: desktop
        zOpen: zSpark
        zWait:
            selector: .zGallery-grid
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Shot_Tablet:
        zViewport: tablet
        zOpen: zSpark
        zWait:
            selector: .zGallery-grid
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Shot_Mobile:
        zViewport: mobile
        zOpen: zSpark
        zWait:
            selector: .zGallery-grid
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Done:
        zMarker: done
