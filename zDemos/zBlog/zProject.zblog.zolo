# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
#
# zProject — distribution manifest for `zolo push` (see zLedger's for the
# annotated reference). Ships everything minus ignore; zCloud wakes `spark`.

zProject:
    slug:       zblog
    name:       zBlog
    spark:      zSpark.zBlog.zolo
    version:    1.0.0
    visibility: public
    tagline:    A full blog — auth, ownership gates, relational posts, avatar upload
    tags:       [social, auth, reference]
    cover:      cover.png
    #> golden-demo convention (zHello/zSciCalc/zQuiz/zLedger/zBooking): SHIP
    #  the zRaven test file + seed_users.py as teaching material, prune only
    #  run artifacts. Data/ ships (seeded users/posts ARE the demo); static/
    #  ships (default avatar the schema default points at). Uploaded avatars
    #  land in static/avatars/ at runtime — only the seeded default ships. <#
    ignore:
        - logs/*
        - zRaven/output/*
        - zRaven/zShots/*
        - zVersions/*
        - "*.db-journal"
        - .zpush_*
        - cover.png   #> rides the multipart, not the app/ slice <#
        #> raven's avatar-upload step copies upload_bank/new_avatar.jpg into
        #  static/avatars/ on every local run — run artifacts, never shipped
        #  (only the schema-default default.png belongs in the slice) <#
        - static/avatars/new_avatar*
