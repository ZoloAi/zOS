# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# zRavenVersion: v1.0.0
# Generated by:  z raven --gen
# Source:        zUI.zPoll.zolo
# Re-run z raven --gen to regenerate structural tests.
# Hand-tuned form values (zFill fields, zSubmit) are preserved across --gen.
# The previous version is archived to zVersions/tests/ (replay: z raven --run --r N).

Tests:

    # ── Bifrost: open page — seeded with 1 poll, 4 options (7/12/4/2 votes,
    #    25 total) so it reads as a live product on first load ─────────────
    Open_App:
        zOpen: zSpark
        zWait:
            selector: .zPoll-question
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Seed_Question:
        zAssert:
            dom:
                selector: .zPoll-question
                contains: What should we build next at zOS Labs?

    Assert_Seed_Options_Count:
        zAssert:
            dom:
                selector: .zPoll-row
                count: 4

    # ── vote on "A CLI tool" — zModal + zDialog(fields: []) onSubmit holds a
    #    real zData block directly (08_data_crud.md per_row "preferred"), a
    #    computed {$inc: 1} update (18_data_advanced.md "computed"), no
    #    plugin ──────────────────────────────────────────────────────────────
    Click_Vote_CLI_Tool:
        zClick:
            selector: ".zPoll-row:has-text('A CLI tool') .zPoll-vote-btn"
        zWait:
            selector: .zModal-overlay
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Confirm_Vote_CLI_Tool:
        zClick:
            selector: ".zModal-overlay button[type='submit']"

    Close_Vote_CLI_Tool:
        zClick:
            selector: .zModal-close
        zWait:
            selector: .zModal-overlay
            state: hidden
            timeout: 8000

    # ── a zModal detour is trail-invisible (08_data_crud.md per_row
    #    "gotcha") — the Refresh button is the next REAL navigation
    #    (self-hop zDelta) that picks up the fresh counter ──────────────────
    Click_Refresh:
        zClick:
            selector: "[data-zkey='Refresh'] button"
        zWait:
            selector: .zPoll-question
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Fresh_Total:
        zAssert:
            dom:
                selector: .zPoll-totals
                contains: 26 votes cast

    Assert_Percent_Recalculated:
        zAssert:
            dom:
                selector: ".zPoll-row:has-text('A CLI tool') .zPoll-percent"
                contains: 50

    # ── start a brand new poll — question + 2 required + 1 optional option,
    #    4th left blank on purpose (07_forms.md optional field) ────────────
    Click_New_Poll:
        zClick:
            selector: "[data-zkey='NewPoll'] button"
        zWait:
            selector: "[name='question']"
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Fill_New_Poll:
        zFill:
            question:  Which mascot should zPoll ship with?
            option_1:  A raven
            option_2:  A fox
            option_3:  A comet
        zShot:
            full_page: true

    Click_Back:
        zClick:
            selector: "[data-zkey='Back'] button"
        zWait:
            selector: .zPoll-question
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_New_Question:
        zAssert:
            dom:
                selector: .zPoll-question
                contains: Which mascot should zPoll ship with?

    # ── a genuine SQL NULL sum, rescued by | default(0) ────────────────────
    Assert_New_Poll_Zero_Votes:
        zAssert:
            dom:
                selector: .zPoll-totals
                contains: 0 votes cast

    # ── Shippable at all three viewports ─────────────────────────────────────
    Shot_Desktop:
        zViewport: desktop
        zOpen: zSpark
        zWait:
            selector: .zPoll-question
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Shot_Tablet:
        zViewport: tablet
        zOpen: zSpark
        zWait:
            selector: .zPoll-question
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Shot_Mobile:
        zViewport: mobile
        zOpen: zSpark
        zWait:
            selector: .zPoll-question
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Done:
        zMarker: done
