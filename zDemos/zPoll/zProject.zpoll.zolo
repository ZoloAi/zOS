# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
#
# zProject — distribution manifest for `zolo push` (see zLedger's for the
# annotated reference). Ships everything minus ignore; zCloud wakes `spark`.

zProject:
    slug:       zpoll
    name:       zPoll
    spark:      zSpark.zPoll.zolo
    version:    1.0.0
    visibility: public
    tagline:    A live poll — vote, watch the tally move, and spin up new polls
    tags:       [voting, aggregate, reference]
    cover:      cover.png
    #> golden-demo convention: SHIP the zRaven test file as teaching material,
    #  prune only run artifacts. Data/ ships (the seed poll + option counters
    #  ARE the demo — the denormalized `votes` column is the whole teaching
    #  point). No upload_bank here: zPoll takes no file inputs. <#
    ignore:
        - logs/*
        - zRaven/output/*
        - zRaven/zShots/*
        - zVersions/*
        - "*.db-journal"
        - .zpush_*
        - cover.png   #> rides the multipart, not the app/ slice <#
