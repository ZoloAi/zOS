# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# zRavenVersion: v1.0.0
# Generated by:  z raven --gen
# Source:        zUI.zscicalc.zolo
# Re-run z raven --gen to regenerate structural tests.
# Hand-tuned form values (zFill fields, zSubmit) are preserved across --gen.
# The previous version is archived to zVersions/tests/ (replay: z raven --run --r N).

Tests:

    # ── Bifrost: open page ──────────────────────────────────────────────
    Open_App:
        zOpen: zSpark
        zWait:
            selector: .zSciCalc-keypad
            state: visible
            timeout: 8000

    Wait_Keypad_Buttons:
        zWait:
            selector: .zSciCalc-key
            state: visible
            timeout: 8000

    Assert_Keypad_Clean:
        zAssert:
            dom:
                selector: .zSciCalc-keypad-basic .zSciCalc-key
                count: 20

    Assert_Expr_Class:
        zAssert:
            dom:
                selector: input[name='Expr']
                property: className
                contains: zSciCalc-expr

    Assert_Sci_Count:
        zAssert:
            dom:
                selector: .zSciCalc-keypad-sci .zSciCalc-key
                count: 16

    Wait_Sci_Hidden:
        zWait:
            selector: .zSciCalc-keypad-sci
            state: hidden
            timeout: 8000

    # ── Toggle: reveal the scientific panel, build sin(pi/2) by CLICKING ───
    Click_Toggle_Sci:
        zClick:
            selector: .zSciCalc-toggle

    Wait_Sci_Visible:
        zWait:
            selector: .zSciCalc-keypad-sci
            state: visible
            timeout: 8000

    Click_Sin:
        zClick:
            selector: .zSciCalc-keypad-sci [data-key='sin(']

    Click_Pi:
        zClick:
            selector: .zSciCalc-keypad-sci [data-key='pi']

    Click_Slash:
        zClick:
            selector: .zSciCalc-keypad-basic [data-key='/']

    Click_Two:
        zClick:
            selector: .zSciCalc-keypad-basic [data-key='2']

    Click_Close_Paren:
        zClick:
            selector: .zSciCalc-keypad-sci [data-key=')']

    Assert_Expr_Built:
        zAssert:
            dom:
                selector: input[name='Expr']
                property: value
                contains: sin(pi/2)

    Shot_Sci_Panel:
        zShot: {full_page: true}

    Click_Submit_Sci:
        zClick:
            selector: button[type='submit']

    Wait_Feedback_Sci:
        zWait:
            selector: .zDialog-feedback
            state: visible
            timeout: 8000

    Assert_Sci_Result:
        zAssert:
            dom:
                selector: body
                contains: sin(pi/2) = 1

    # ── During: typed, pre-submit — prove the styled display + keypad ──────
    Type_Expr:
        zType:
            selector: input[name='Expr']
            value: 3 + 4 * 2

    Shot_During_Submit:
        zShot: {full_page: true}

    # ── After: submitted — prove the styled success feedback ───────────────
    Click_Submit:
        zClick:
            selector: button[type='submit']

    Wait_Feedback:
        zWait:
            selector: .zDialog-feedback
            state: visible
            timeout: 8000

    Assert_Result:
        zAssert:
            dom:
                selector: body
                contains: 3 + 4 * 2 = 11

    Shot_After_Submit:
        zShot: {full_page: true}

    # ── Structural regression: dual-mode zFill still fills + submits ───────
    Fill_Evaluate_Form:
        zFill:
            Expr: 3 + 4 * 2

    # ── Shippable bar: 3 viewports ────────────────────────────────────────
    Shot_mobile:
        zViewport: mobile
        zOpen: zSpark
        zWait:
            selector: .zSciCalc-key
            state: visible
            timeout: 8000
        zShot: {full_page: true}

    Shot_tablet:
        zViewport: tablet
        zOpen: zSpark
        zWait:
            selector: .zSciCalc-key
            state: visible
            timeout: 8000
        zShot: {full_page: true}

    Shot_desktop:
        zViewport: desktop
        zOpen: zSpark
        zWait:
            selector: .zSciCalc-key
            state: visible
            timeout: 8000
        zShot: {full_page: true}

    Done:
        zMarker: done
