# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.

zMeta:
    Data_Type:         csv
    Data_Path:         @.Data
    Data_Label:        Contacts
    Schema_Name:       zSchema.Contacts
    zMigration:        true
    zMigrationVersion: v1.0.0

Contacts:
    id:
        type:           int
        pk:             true
        auto_increment: true

    name:
        type:     str
        required: true
        rules:
            max_length: 120

    email:
        type:     str
        required: true
        unique:   true
        rules:
            format: email

    #> zolo is string-first — quotes are literal chars, NOT empty-string syntax.
    #  an empty-string default is just a bare/blank value after the colon <#
    phone:
        type:    str
        default:

    #> the relational core of this app: a contact points at a company row —
    #  zData refuses a company_id that isn't really sitting in Companies, and
    #  on_delete: set_null means removing a company un-links its contacts
    #  instead of blocking the delete or dragging the contacts along <#
    company_id:
        type:         int
        nullable:     true
        foreign_key:  Companies.id
        on_delete:    set_null

    created_at:
        type:    datetime
        default: now
