# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
#
# zProject — distribution manifest for `zolo push` (see zLedger's for the
# annotated reference). Ships everything minus ignore; zCloud wakes `spark`.

zProject:
    slug:       zcontacts
    name:       zContacts
    spark:      zSpark.zcontacts.zolo
    version:    1.0.0
    visibility: public
    tagline:    A contact book — relational FKs, auto_join directory, and live migrations
    tags:       [crm, relational, reference]
    cover:      cover.png
    #> golden-demo convention: SHIP the zRaven test file as teaching material,
    #  prune only run artifacts. Data/ ships (seed contacts + companies ARE the
    #  demo), and Data/zmigrations/ ships WITH it — the applied v1.1.0 `notes`
    #  migration is this demo's whole teaching point (zMigrationVersion). <#
    ignore:
        - logs/*
        - zRaven/output/*
        - zRaven/zShots/*
        - zVersions/*
        - "*.db-journal"
        - .zpush_*
        - cover.png   #> rides the multipart, not the app/ slice <#
