# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# zRavenVersion: v1.0.0
# Generated by:  z raven --gen
# Source:        zUI.zcontacts.zolo
# Re-run z raven --gen to regenerate structural tests.
# Hand-tuned form values (zFill fields, zSubmit) are preserved across --gen.
# The previous version is archived to zVersions/tests/ (replay: z raven --run --r N).

Tests:

    # ── Open: seeded Contacts list, FK resolved ─────────────────────────────
    Open_App:
        zOpen: zSpark
        zWait:
            selector: .zContacts-card
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    #> dom: drives the real Bifrost DOM check (element count); contains: is the
    #  CLI-mode fallback in the SAME zAssert — evaluate_assert (WS) checks
    #  dom first and never looks at contains, evaluate_text_assert (CLI) has
    #  no notion of dom and only checks contains — so each runner reads the
    #  ONE key it understands, no zCLI:/zBifrost: wrapper split needed. This
    #  is the only assertion in this file reachable pre-navigation in CLI
    #  (everything after this point is behind a zClick, Bifrost-only) <#
    Assert_Seed_Rows:
        zAssert:
            dom:
                selector: .zContacts-row
                count: 3
            contains: Ada Lovelace

    # ── Add a contact, linked to a company via its FK field ────────────────
    Pick_Add:
        zClick:
            selector: "[data-zkey='Add'] button"
        zShot:
            full_page: true

    Fill_Add_Form:
        zFill:
            name:       Margaret Hamilton
            email:      margaret@acme.test
            phone:      555-0199
            company_id: 1
        zShot:
            full_page: true

    Back_From_Add:
        zClick:
            selector: "[data-zkey='Back'] button"
        zShot:
            full_page: true

    Assert_Row_Added:
        zAssert:
            dom:
                selector: .zContacts-row
                count: 4

    Assert_New_Row_Company:
        zAssert:
            dom:
                selector: ".zContacts-row:has-text('Margaret Hamilton') .zContacts-detail"
                contains: Company #1

    # ── Delete the row just added — zModal+zDialog(fields: []) onSubmit, no
    #    plugin (08_data_crud.md per_row). A modal detour is trail-invisible
    #    (navigation_detour.py) — it never re-renders Main, so the row stays
    #    in the DOM until the next REAL navigation (the Companies hop right
    #    after this proves it, same "re-read via a fresh hop" as zShop cart) ─
    Click_Delete_New_Row:
        zClick:
            selector: ".zContacts-row:has-text('Margaret Hamilton') .zContacts-delete"
        zWait:
            selector: .zModal-overlay
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Confirm_Delete_New_Row:
        zClick:
            selector: ".zModal-overlay button[type='submit']"

    Close_Delete_New_Row:
        zClick:
            selector: .zModal-close
        zWait:
            selector: .zModal-overlay
            state: hidden
            timeout: 8000

    # ── Companies: manage the OTHER side of the relationship ────────────────
    Pick_Manage_Companies:
        zClick:
            selector: "[data-zkey='ManageCompanies'] button"
        zWait:
            selector: "[data-zkey='Add_Company'], h1:has-text('Companies')"
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Company_Rows:
        zAssert:
            dom:
                selector: .zContacts-row
                count: 2

    Pick_Add_Company:
        zClick:
            selector: "[data-zkey='Add'] button"
        zShot:
            full_page: true

    Fill_Add_Company_Form:
        zFill:
            name:     Initech
            industry: Software
            notes:    Prospect, met at zConf 2026
        zShot:
            full_page: true

    Back_From_Add_Company:
        zClick:
            selector: "[data-zkey='Back'] button"
        zShot:
            full_page: true

    Assert_Company_Added:
        zAssert:
            dom:
                selector: .zContacts-row
                count: 3

    #> proves the v1.1.0 migration column round-trips: insert -> read -> render <#
    Assert_Company_Notes_Rendered:
        zAssert:
            dom:
                selector: ".zContacts-row:has-text('Initech') .zContacts-detail"
                contains: zConf 2026

    Back_To_Contacts:
        zClick:
            selector: "[data-zkey='Back'] button"
        zWait:
            selector: .zContacts-card
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    #> the Companies detour above is the real navigation that re-runs
    #  prepare_block_render on Main, picking up the post-delete spool <#
    Assert_Row_Gone:
        zAssert:
            dom:
                not_contains: Margaret Hamilton

    # ── Directory: the relational payoff — auto_join fed to zTable ──────────
    Pick_Directory:
        zClick:
            selector: "[data-zkey='ViewDirectory'] button"
        zWait:
            selector: table
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Directory_Joined:
        zAssert:
            dom:
                selector: table
                contains: Acme Corp

    Assert_Directory_Has_Contact:
        zAssert:
            dom:
                selector: table
                contains: Ada Lovelace

    # ── Shippable at all three viewports ─────────────────────────────────────
    Shot_Desktop:
        zViewport: desktop
        zOpen: zSpark
        zWait:
            selector: .zContacts-card
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Shot_Tablet:
        zViewport: tablet
        zOpen: zSpark
        zWait:
            selector: .zContacts-card
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Shot_Mobile:
        zViewport: mobile
        zOpen: zSpark
        zWait:
            selector: .zContacts-card
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Done:
        zMarker: done
