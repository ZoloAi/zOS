# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# zRavenVersion: v1.0.0
# Generated by:  z raven --gen
# Source:        zUI.zDarkroom.zolo
# Re-run z raven --gen to regenerate structural tests.
# Hand-tuned form values (zFill fields, zSubmit) are preserved across --gen.
# The previous version is archived to zVersions/tests/ (replay: z raven --run --r N).

Tests:

    # ── Bifrost: open page — History IS the home screen, seeded with 3 real
    #    PIL-processed rows (committed static + CSV) so it reads as a real
    #    product on first load, not an empty shell ──────────────────────────
    Open_App:
        zOpen: zSpark
        zWait:
            selector: .zDarkroom-history
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Seed_Rows:
        zAssert:
            dom:
                selector: .zDarkroom-card
                count: 3
            contains: Wool Beanie

    Assert_Seed_Stats_Measured:
        #> proof the seed rows carry REAL measured stats, not placeholders <#
        zAssert:
            dom:
                selector: ".zDarkroom-card:has-text('Mountain Dawn') .zDarkroom-stats"
                contains: grayscale

    # ── Process a new photo: file input + zDialog collector (06_inputs +
    #    07_forms), onSubmit hands off to plugins/darkroom.py for a REAL
    #    PIL transform (not a copy) ──────────────────────────────────────────
    Click_Process:
        zClick:
            selector: "[data-zkey='Process'] button"
        zWait:
            selector: "[name='photo']"
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    #> file BEFORE fields on purpose — zFill's own last-field click submits
    #  the form, so the photo has to already be set when that fires <#
    Upload_Photo_File:
        zUpload:
            selector: "[name='photo']"
            path: upload_bank/ceramic_mug.jpg
        zShot:
            full_page: true

    Fill_Process_Form:
        zFill:
            title:     Ceramic Mug
            operation: blur
        zShot:
            full_page: true

    Back_To_Main:
        zClick:
            selector: "[data-zkey='Back'] button"
        zWait:
            selector: .zDarkroom-history
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Row_Added:
        zAssert:
            dom:
                selector: .zDarkroom-card
                count: 4

    Assert_New_Card_Stats:
        zAssert:
            dom:
                selector: ".zDarkroom-card:has-text('Ceramic Mug') .zDarkroom-stats"
                contains: blur

    # ── Delete the photo just added — per_row zBtn.action -> @zfunc drops
    #    both static files + the row; a fresh reload proves it persisted ────
    Delete_Photo:
        zClick:
            selector: ".zDarkroom-card:has-text('Ceramic Mug') .zDarkroom-delete"
        zShot:
            full_page: true

    Reload_After_Delete:
        zOpen: zSpark
        zWait:
            selector: .zDarkroom-history
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Assert_Row_Deleted:
        zAssert:
            dom:
                selector: .zDarkroom-card
                count: 3

    Assert_Card_Gone:
        zAssert:
            dom:
                selector: .zDarkroom-history
                not_contains: Ceramic Mug

    # ── Shippable at all three viewports ─────────────────────────────────────
    Shot_Desktop:
        zViewport: desktop
        zOpen: zSpark
        zWait:
            selector: .zDarkroom-history
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Shot_Tablet:
        zViewport: tablet
        zOpen: zSpark
        zWait:
            selector: .zDarkroom-history
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Shot_Mobile:
        zViewport: mobile
        zOpen: zSpark
        zWait:
            selector: .zDarkroom-history
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Done:
        zMarker: done
