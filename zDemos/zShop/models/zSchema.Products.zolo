# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.

zMeta:
    Data_Type:         csv
    Data_Path:         @.Data
    Data_Label:        Products
    Schema_Name:       zSchema.Products
    zMigration:        true
    zMigrationVersion: v1.0.0

Products:
    id:
        type:           int
        pk:             true
        auto_increment: true

    name:
        type:     str
        required: true
        rules:
            max_length: 120

    price:
        type:     float
        required: true
        rules:
            min: 0

    category:
        type:    str
        default: General

    description:
        type: str
