# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
#
# zProject — distribution manifest for `zolo push` (see zLedger's for the
# annotated reference). Ships everything minus ignore; zCloud wakes `spark`.

zProject:
    slug:       zconsole
    name:       zConsole
    spark:      zSpark.zConsole.zolo
    version:    1.0.0
    visibility: public
    tagline:    A dev console — zDash shell, runnable zTerminal snippets, live status
    tags:       [devtools, zTerminal, reference]
    cover:      cover.png
    #> golden-demo convention: SHIP the zRaven test file as teaching material,
    #  prune only run artifacts. Data/ ships (the SystemMetrics seed feeds the
    #  Status panel's zKnot math). zEnv.base.zolo ships — ZTERMINAL_MODE:
    #  sandbox is the safety dial that keeps the hosted Run buttons executing
    #  snippets in the sandboxed posture, never raw on the host. <#
    ignore:
        - logs/*
        - zRaven/output/*
        - zRaven/zShots/*
        - zVersions/*
        - _zSpark.*
        - "*.db-journal"
        - .zpush_*
        - cover.png   #> rides the multipart, not the app/ slice <#
        - "ChatGPT Image*"   #> marketing banner draft, not an app asset <#
