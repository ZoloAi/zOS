# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# TODO: local zbifrost-client checkout for dev only — unset before shipping public (falls back to CDN @1 channel).

# The Snippets panel's samples are ours (authored in this repo, python-only, no
# os/files/network per 20_terminal.md's sandbox_policy) — sandbox is the honest
# dial for that trust level. `trust` would be clamped to sandbox over Bifrost
# anyway (20_terminal.md's `web` row), so sandbox IS the effective ceiling here.
ZTERMINAL_MODE: sandbox

ZBIFROST_CLIENT_BASE: /zbifrost
zServer:
    mounts:
        zbifrost: /Users/galnachshon/Projects/zbifrost-client
