# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# zRavenVersion: v1.0.0
# Generated by:  z raven --gen
# Source:        zUI.zConsole.zolo
# Re-run z raven --gen to regenerate structural tests.
# Hand-tuned form values (zFill fields, zSubmit) are preserved across --gen.
# The previous version is archived to zVersions/tests/ (replay: z raven --run --r N).

Tests:

    # ── Bifrost: open page ──────────────────────────────────────────────
    Open_App:
        zOpen: zSpark
        zWait:
            selector: body
            state: visible
            timeout: 8000


    # ── Dashboard panels ──────────────────────────────────────────────────


    Assert_Overview_Default:
        zAssert:
            dom:
                selector: .zTab-pane.zActive
                contains: zConsole

    Dash_Pick_Snippets:
        zPick: Snippets
    #> a bare `contains` checks the last WS response (here it'd coincidentally
    #  match the echoed {option: 'Snippets'}, never the live page) — `dom:`
    #  reads the ACTIVE tab pane's real rendered text <#
    Assert_Snippets:
        zAssert:
            dom:
                selector: .zTab-pane.zActive
                contains: Snippets
    #> ZTERMINAL_MODE: sandbox (zEnv.development.zolo) makes the Run button
    #  appear at all (terminal_renderer._isRunnable gates it client-side) —
    #  scope by the block's own title text since terminalId is random per
    #  render, not stable across runs <#
    Click_Run_Factorial:
        zClick:
            selector: .zTerminal-container:has-text('Factorials') button:has-text('Run')
    Assert_Factorial_Output:
        zWait:
            selector: .zTerminal-container:has-text('Factorials') .zTerminal-output
            state: visible
            timeout: 8000
        zAssert:
            dom:
                selector: .zTerminal-container:has-text('Factorials') .zTerminal-output
                contains: 120
    Click_Run_Fibonacci:
        zClick:
            selector: .zTerminal-container:has-text('Fibonacci') button:has-text('Run')
    Assert_Fibonacci_Output:
        zWait:
            selector: .zTerminal-container:has-text('Fibonacci') .zTerminal-output
            state: visible
            timeout: 8000
        zAssert:
            dom:
                selector: .zTerminal-container:has-text('Fibonacci') .zTerminal-output
                contains: 13
    Shot_Snippets:
        zShot:
            full_page: true

    Dash_Pick_Status:
        zPick: Status
    Assert_Status:
        zAssert:
            dom:
                selector: .zTab-pane.zActive
                contains: Status
    #> locks in the &zNow builtin fix — message_utils.resolve_data_variables
    #  (the ONLY string-resolution pass a non-chunked Bifrost panel goes
    #  through) used to handle %data.* only, never &function calls, so
    #  "&zNow" shipped to the browser as a literal token <#
    Assert_Status_Live_Clock:
        zAssert:
            dom:
                selector: .zTab-pane.zActive
                not_contains: &zNow
    #> locks in the page-scope zKnot fix — 512/2048*100 = 25, computed via
    #  {zDiv:[...]} nested in {zMul:[..., 100]} through the CLI zDash binding
    #  path (system_event_dashboard._bind_panel_data), which used to skip
    #  expand_knots entirely (zAgents zLoom audit finding #6). A bare `contains`
    #  checks the last WS response, not the page — needs `dom:` here, or it'd
    #  coincidentally pass against the prior zPick's own echoed option name <#
    Assert_Status_Mem_Pct:
        zAssert:
            dom:
                selector: .zConsole-metric
                contains: 25
    Shot_Status:
        zShot:
            full_page: true

    Dash_Pick_Hosting:
        zPick: Hosting
    Assert_Hosting:
        zAssert:
            dom:
                selector: .zTab-pane.zActive
                contains: Hosting
    Shot_Hosting:
        zShot:
            full_page: true

    # ── Shippable at all three viewports ─────────────────────────────────────
    Shot_Desktop:
        zViewport: desktop
        zOpen: zSpark
        zWait:
            selector: .zDash-container
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Shot_Tablet:
        zViewport: tablet
        zOpen: zSpark
        zWait:
            selector: .zDash-container
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Shot_Mobile:
        zViewport: mobile
        zOpen: zSpark
        zWait:
            selector: .zDash-container
            state: visible
            timeout: 8000
        zShot:
            full_page: true

    Done:
        zMarker: done
