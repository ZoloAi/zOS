# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.

zSpark:
    title:     Calculator
    zMode:     zBifrost
    zLog:      INFO
    zLogPath:  @.logs
    zVaFolder: @.zViews
    zVaFile:   zUI.zcalculator
    zBlock:    zVaF
    zServer:
        enabled: true

zInfo:
    description: Golden reference — pure logic/computation, no data layer
    tags: [zDialog, zFunc]
    author: zAgents
