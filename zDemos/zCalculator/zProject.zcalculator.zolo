# .zolo — zOS UI language. NOT YAML. String-first by default: no quotes unless : { # present.
#
# zProject — distribution manifest for `zolo push` (see zLedger's for the
# annotated reference). Ships everything minus ignore; zCloud wakes `spark`.

zProject:
    slug:       zcalculator
    name:       zCalculator
    spark:      zSpark.zcalculator.zolo
    visibility: public
    tagline:    A clean everyday calculator — the hello-world of zUI forms
    tags:       [tools]
    ignore:
        - zRaven
        - logs
        - zVersions
        - zShots
