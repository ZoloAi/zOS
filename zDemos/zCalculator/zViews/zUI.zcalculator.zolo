# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.

zMeta:
    zNavBar: false

zVaF:
    zH1:
        label: Calculator
        color: PRIMARY

    zText:
        content: Add two numbers.

    zDialog:
        title: Add
        fields: [
            {zConv: num1, type: number},
            {zConv: num2, type: number},
        ]
        onSubmit:
            zFunc: &.calculator.add(zConv.num1, zConv.num2)
