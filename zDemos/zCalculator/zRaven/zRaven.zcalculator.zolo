# .zolo — NOT YAML: string-first, no quotes needed, indentation-only nesting.
# zRavenVersion: v1.0.0
# Generated by:  z raven --gen
# Source:        zUI.zcalculator.zolo
# Re-run z raven --gen to regenerate structural tests.
# Hand-tuned form values (zFill fields, zSubmit) are preserved across --gen.
# The previous version is archived to zVersions/tests/ (replay: z raven --run --r N).

Tests:

    # ── Bifrost: open page ──────────────────────────────────────────────
    Open_App:
        zOpen: zSpark
        zWait:
            selector: body
            state: visible
            timeout: 8000

    Fill_Add_Form:
        zFill:
            num1: 3
            num2: 4

    Assert_Sum:
        zAssert:
            dom:
                selector: body
                contains: 3 + 4 = 7

    # ── Shippable bar: 3 viewports ────────────────────────────────────────
    Shot_mobile:
        zViewport: mobile
        zOpen: zSpark
        zWait:
            selector: h1
            state: visible
        zShot: {}

    Shot_tablet:
        zViewport: tablet
        zOpen: zSpark
        zWait:
            selector: h1
            state: visible
        zShot: {}

    Shot_desktop:
        zViewport: desktop
        zOpen: zSpark
        zWait:
            selector: h1
            state: visible
        zShot: {}

    Done:
        zMarker: done
