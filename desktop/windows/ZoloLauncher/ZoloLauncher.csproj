<Project Sdk="Microsoft.NET.Sdk">

  <!-- Zolo.exe — the Windows twin of desktop/macos (zOS #33).
       Build on a Windows box (or the ONE batched CI run) via ..\build.ps1;
       signing waits on the Trusted Signing cert (see build.ps1 hook). -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Zolo</AssemblyName>
    <ApplicationIcon>..\assets\zolo.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Version>1.0.0</Version>
    <Company>Zolo Media</Company>
    <Product>Zolo</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
  </ItemGroup>

</Project>
