# ─────────────────────────────────────────────────────────────────────────────
# zOS-OpenCore — ignored paths
#
# TRACKED (source of truth): pyproject.toml, setup.py, MANIFEST.in, uv.lock,
# README.md, .gitignore, .gitmodules — these must stay at the repo root.
#
# Everything below is GENERATED or LOCAL. It is rebuilt on demand and must
# NEVER be committed. Grouped by what produces it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Python environment — rebuilt by `uv sync` / `uv venv` ──
.venv/
venv/
.python-version

# ── Build & packaging output — rebuilt by `uv build` (→ PyPI via twine) ──
/build/
/dist/
*.egg-info/
/zos_plugin/          # generated plugin shim package

# ── Caches — recreated by the tools themselves ──
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Generated assets ──
zTheme/               # generated theme assets

# ── Editor / OS cruft ──
.DS_Store

# ── Cursor IDE state — local workspace config (rules regenerated by `z agents`/`z patch`) ──
.cursor/
.cursorignore
.cursorindexingignore

# ── zDemos — WIP reference apps + zScaffold templates. Heavy churn, far from
# shippable; zScaffold is mid-rebuild. Kept on disk for `z scaffold`/`z demos` in
# editable installs (regular installs use the remote manifest). Untracked until
# further notice to keep history clean — do NOT re-track without a deliberate decision.
zDemos/
